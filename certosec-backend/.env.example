# ============================================================
# CertoSec V2 backend - environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3000

# Allowed CORS origins (comma separated). Never "*" in production.
# For the Flutter app: the web build origin, or the API proxy origin.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Log level: dev | combined
LOG_FORMAT=dev

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SERVICE ROLE KEY - backend only. NEVER expose to Flutter.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OPTIONAL (legacy HS256 projects only): access tokens are verified against
# the project's published public keys (JWKS) instead. Modern projects sign with
# ES256 and the dashboard "JWT secret" is just a key id — leave this unset.
# SUPABASE_JWT_SECRET=

# Email that is provisioned as the admin role on first login (lowercase).
ADMIN_EMAIL=admin@example.com
# Redirect target for Supabase password reset emails (points at the Flutter app).
PASSWORD_RESET_URL=http://localhost:3000/auth/reset

# --- Supabase Storage (certificate PDFs) ---
STORAGE_BUCKET=certificates
MAX_PDF_MB=10
STORAGE_SIGNED_URL_EXPIRY=3600

# --- Blockchain (Polygon Amoy testnet) ---
BLOCKCHAIN_RPC_URL=https://polygon-amoy.drpc.org
BLOCKCHAIN_CHAIN_ID=80002
# Backend-only signer. NEVER commit, NEVER expose via API, NEVER store in DB.
# Fund the wallet with test MATIC from a faucet (e.g. https://faucet.polygon.technology).
# For Remix: deploy contracts/CertoSecRegistry.sol, then put its address here.
BLOCKCHAIN_PRIVATE_KEY=
# Address of the deployed CertoSec contract.
CONTRACT_ADDRESS=
NETWORK_NAME=Polygon Amoy
BLOCKCHAIN_CONFIRMATIONS=1

# --- Issuer identity shown on certificates ---
ISSUER_NAME=CertoSec University Network
